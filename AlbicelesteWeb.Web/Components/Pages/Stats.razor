@page "/stats"
@attribute [StreamRendering]
@using AlbicelesteWeb.Data
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AlbicelesteDbContext> DbFactory

<PageTitle>Database stats · Albiceleste Stats</PageTitle>

<header class="page-header">
    <div class="kicker">Behind the scenes</div>
    <h1>Database stats</h1>
    <p class="subtitle">Rows in each table of the SQL Server database</p>
</header>

@if (stats is null)
{
    <p class="subtitle">Counting rows…</p>
}
else
{
    <section class="kpi-row" aria-label="Row counts">
        <KpiCard Label="Players" Value="@stats.Players.ToString("N0")" Code="db.Players.CountAsync()" />
        <KpiCard Label="Clubs" Value="@stats.Clubs.ToString("N0")" Code="db.Clubs.CountAsync()" />
        <KpiCard Label="Competitions" Value="@stats.Competitions.ToString("N0")" Code="db.Competitions.CountAsync()" />
        <KpiCard Label="Appearances" Value="@stats.Appearances.ToString("N0")" Code="db.Appearances.CountAsync()" />
    </section>

    <section class="card-panel" aria-labelledby="how-h">
        <div class="card-panel-head">
            <h2 id="how-h">How the data got here</h2>
            <p>CSV files → Importer (CsvHelper, EF Core, SqlBulkCopy) → SQL Server → this app (EF Core, Blazor)</p>
        </div>
        <pre class="query"><span class="comment">// One short-lived DbContext per operation (Blazor Server)</span>
<span class="accent">await using var</span> db = <span class="accent">await</span> DbFactory.CreateDbContextAsync();
<span class="accent">int</span> appearances = <span class="accent">await</span> db.Appearances.CountAsync();</pre>
    </section>
}

@code {
    private StatsModel? stats;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        stats = new StatsModel(
            Players: await db.Players.CountAsync(),
            Clubs: await db.Clubs.CountAsync(),
            Competitions: await db.Competitions.CountAsync(),
            Appearances: await db.Appearances.CountAsync());
    }

    private record StatsModel(int Players, int Clubs, int Competitions, int Appearances);
}
