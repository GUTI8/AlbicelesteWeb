@page "/not-found"
@layout MainLayout

<PageTitle>Page not found · Albiceleste Stats</PageTitle>

<header class="page-header">
    <div class="kicker">Error 404</div>
    <h1>Page not found</h1>
    <p class="subtitle">That address doesn't match any page in Albiceleste Stats.</p>
</header>

<section class="card-panel" aria-label="Where to go next">
    <div class="card-panel-head">
        <h2>Where to next?</h2>
        <p>Try the dashboard, or search for a player.</p>
    </div>
    <div class="card-panel-body" style="display: flex; flex-wrap: wrap; gap: 12px;">
        <a class="btn-flat primary" href="">Dashboard</a>
        <a class="btn-flat dark" href="players">Search players</a>
    </div>
</section>