@page "/players"
@rendermode InteractiveServer
@* @rendermode @(new InteractiveServerRenderMode(prerender: false)) *@
@using AlbicelesteWeb.Web.Services
@inject PlayerService PlayerService

<PageTitle>Players · Albiceleste Stats</PageTitle>

<header class="page-header">
    <div class="kicker">Interactive · filtered and paged in SQL</div>
    <h1>Players</h1>
    <p class="subtitle">Search, filter and page through Argentine players</p>
</header>

<form class="filters" @onsubmit="SearchAsync">
    <div class="field grow">
        <label for="search">Search by name</label>
        <input id="search" type="search" placeholder="e.g. Martínez" @bind="search" />
    </div>

    <div class="field">
        <span class="field-label" id="pos-label">Position</span>
        <div class="pills" role="group" aria-labelledby="pos-label">
            @foreach (var option in positions)
            {
                <button type="button"
                        class="pill @(option.Value == position ? "on" : "")"
                        aria-pressed="@(option.Value == position ? "true" : "false")"
                        @onclick="() => SetPositionAsync(option.Value)">
                    @option.Label
                </button>
            }
        </div>
    </div>

    <div class="field">
        <label for="sort">Sort by</label>
        <select id="sort" @bind="sort" @bind:after="ReloadFromFirstPageAsync">
            <option value="@PlayerSort.ValueDesc">Market value</option>
            <option value="@PlayerSort.Youngest">Youngest first</option>
            <option value="@PlayerSort.Oldest">Oldest first</option>
            <option value="@PlayerSort.Name">Name (A–Z)</option>
        </select>
    </div>

    <label class="check">
        <input type="checkbox" @bind="activeOnly" @bind:after="ReloadFromFirstPageAsync" />
        Active only
    </label>

    <button type="submit" class="btn-flat primary">Search</button>
</form>

<section class="results" aria-label="Results">
    <div class="results-head">
        <strong>@ResultsLabel</strong>
        <strong>@(result is null ? "…" : result.TotalCount.ToString("N0")) players</strong>
        @if (loading)
        {
            <span class="muted">Loading…</span>
        }
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Player</th>
                    <th scope="col">Position</th>
                    <th scope="col">Club</th>
                    <th scope="col" class="num">Age</th>
                    <th scope="col" class="num">Value</th>
                </tr>
            </thead>
            <tbody>
                @if (result is not null)
                {
                    foreach (var row in result.Items)
                    {
                        <tr>
                            <td class="name"><a href="players/@row.PlayerId">@row.Name</a></td>
                            <td>
                                <span class="badge">@row.Position</span>
                                <span class="sub">@row.SubPosition</span>
                            </td>
                            <td>@(row.Club ?? "Unknown club")</td>
                            <td class="num">@(row.Age?.ToString() ?? "–")</td>
                            <td class="num strong">@Format.Euros(row.MarketValue)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (result is { TotalCount: 0 })
    {
        <p class="empty">No players match. The query still ran; it just returned an empty list.</p>
    }

    <div class="pager">
        <button type="button" class="btn-flat dark" disabled="@(page <= 1 || loading)" @onclick="PreviousAsync">Previous</button>
        <span>Page @(page) of @(result?.TotalPages ?? 1)</span>
        <button type="button" class="btn-flat dark" disabled="@(result is null || page >= result.TotalPages || loading)" @onclick="NextAsync">Next</button>
    </div>
</section>

<section class="card-panel sql-panel" aria-label="SQL behind this view">
    <div class="card-panel-head">
        <h2>SQL behind this view</h2>
        <p>Generated by EF Core with ToQueryString(). It changes as you filter, sort and page.</p>
    </div>
    <pre class="query">@result?.Sql</pre>
</section>

@code {
    private readonly (string Label, string? Value)[] positions =
    {
        ("All", null),
        ("Goalkeeper", "Goalkeeper"),
        ("Defender", "Defender"),
        ("Midfield", "Midfield"),
        ("Attack", "Attack")
    };

    // The page's state lives on the server, in this component, for as long as the user stays connected
    private string? search;
    private string? position;
    private PlayerSort sort = PlayerSort.ValueDesc;
    private bool activeOnly = true;
    private int page = 1;

    private PagedResult<PlayerRow>? result;
    private bool loading;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task SearchAsync() => ReloadFromFirstPageAsync();

    private Task SetPositionAsync(string? value)
    {
        position = value;
        return ReloadFromFirstPageAsync();
    }

    // Any filter change starts again from page 1
    private Task ReloadFromFirstPageAsync()
    {
        page = 1;
        return LoadAsync();
    }

    private Task PreviousAsync()
    {
        page--;
        return LoadAsync();
    }

    private Task NextAsync()
    {
        page++;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        result = await PlayerService.SearchAsync(new PlayerQuery(search, position, activeOnly, sort, page, PageSize: 20));
        loading = false;
    }
    
    private string ResultsLabel => result is null
        ? "…"
        : $"{result.TotalCount:N0} {(result.TotalCount == 1 ? "player" : "players")}";
}
